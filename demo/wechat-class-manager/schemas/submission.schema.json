{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Submission",
  "type": "object",
  "required": [
    "submission_id",
    "student",
    "challenge",
    "timestamp",
    "files",
    "status"
  ],
  "properties": {
    "submission_id": {
      "type": "string"
    },
    "student": {
      "type": "string"
    },
    "wechat_id": {
      "type": "string"
    },
    "challenge": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "level_claimed": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "received",
        "reviewing",
        "accepted",
        "needs_revision"
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "missing_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
