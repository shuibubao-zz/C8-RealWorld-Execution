{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Student Profile",
  "type": "object",
  "required": [
    "wechat_id",
    "nickname"
  ],
  "properties": {
    "wechat_id": {
      "type": "string"
    },
    "nickname": {
      "type": "string"
    },
    "major": {
      "type": "string"
    },
    "enrollment_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "skill_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "message_count": {
      "type": "integer"
    },
    "question_count": {
      "type": "integer"
    },
    "answer_count": {
      "type": "integer"
    },
    "submission_count": {
      "type": "integer"
    },
    "last_active": {
      "type": [
        "string",
        "null"
      ]
    },
    "_profile_note": {
      "type": "string"
    }
  }
}
