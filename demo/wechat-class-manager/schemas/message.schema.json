{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WeChat Group Message (UMF-compatible, Level 1)",
  "type": "object",
  "required": [
    "msg_id",
    "timestamp",
    "sender",
    "type",
    "content",
    "media_ref",
    "reply_to"
  ],
  "additionalProperties": false,
  "properties": {
    "msg_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sender": {
      "type": "object",
      "required": [
        "wechat_id",
        "nickname"
      ],
      "properties": {
        "wechat_id": {
          "type": "string"
        },
        "nickname": {
          "type": "string"
        }
      }
    },
    "type": {
      "type": "string",
      "enum": [
        "text",
        "image",
        "file",
        "voice",
        "link",
        "system"
      ]
    },
    "content": {
      "type": "string"
    },
    "media_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "reply_to": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
